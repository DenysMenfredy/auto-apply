# Default profile source paths (CLI flags take precedence)
AUTOAPPLY_RESUME=
AUTOAPPLY_LINKEDIN=

# pino log level: debug | info | warn | error
AUTOAPPLY_LOG_LEVEL=info

# Search provider: google | google-cse | duckduckgo | browser
AUTOAPPLY_SEARCH_PROVIDER=

# Browser provider (--provider browser): drives your installed Google Chrome.
# Set AUTOAPPLY_BROWSER_HEADED=1 to watch it / solve a CAPTCHA once (kept in
# cache/browser-profile). AUTOAPPLY_BROWSER_EXECUTABLE overrides the binary.
AUTOAPPLY_BROWSER_HEADED=
AUTOAPPLY_BROWSER_EXECUTABLE=

# Google Custom Search (provider "google-cse") — see README for setup
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Override the google scraper endpoint (e.g. a self-hosted SearXNG /search route)
GOOGLE_SEARCH_BASE_URL=

# Override the HTTP user agent used for search and job pages
AUTOAPPLY_USER_AGENT=

# ── Agent (AGENT_PLAN M0) ────────────────────────────────────────────────
# Which model plans and refines queries: "provider" or "provider:model".
# Wired providers: anthropic (default claude-opus-5), deepseek (default
# deepseek-v4-flash; the deep tier switches to deepseek-v4-pro).
AUTOAPPLY_LLM=

# Credential for whichever provider is selected — only that one is needed.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
